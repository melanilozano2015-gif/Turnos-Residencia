@model ResidenciaApp.Models.NinoAdolescente

@{
    ViewData["Title"] = "Eliminar";
}

<div class="page-header">
    <h1><i class="bi bi-trash"></i> Eliminar</h1>
    <a asp-action="Index" class="btn btn-outline-primary">Volver</a>
</div>

<div class="card">
    <div class="card-body">
        <h5>¿Estás seguro que deseas eliminar este registro?</h5>
        <hr />
        <dl class="row">
            <dt class="col-sm-3">DNI</dt>
            <dd class="col-sm-9">@Model.Dni</dd>

            <dt class="col-sm-3">Nombre</dt>
            <dd class="col-sm-9">@Model.Nombre @Model.Apellido</dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="IdNinoAdolescente" />
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash"></i> Eliminar
            </button>
        </form>
    </div>
</div>
