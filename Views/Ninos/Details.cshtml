@model ResidenciaApp.Models.NinoAdolescente

@{
    ViewData["Title"] = "Detalles";
}

<div class="page-header">
    <h1><i class="bi bi-person"></i> Detalles</h1>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.IdNinoAdolescente" class="btn btn-primary">
            <i class="bi bi-pencil"></i> Editar
        </a>
        <a asp-action="Turnos" asp-route-id="@Model.IdNinoAdolescente" class="btn btn-outline-primary">
            <i class="bi bi-calendar-check"></i> Ver Turnos
        </a>
        <a asp-action="Index" class="btn btn-outline-primary">Volver</a>
    </div>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-person-badge"></i> Datos personales
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">DNI</dt>
                    <dd class="col-sm-8">@Model.Dni</dd>

                    <dt class="col-sm-4">Nombre</dt>
                    <dd class="col-sm-8">@Model.Nombre</dd>

                    <dt class="col-sm-4">Apellido</dt>
                    <dd class="col-sm-8">@Model.Apellido</dd>

                    <dt class="col-sm-4">Fecha de Nacimiento</dt>
                    <dd class="col-sm-8">@Model.FechaNacimiento.ToString("dd/MM/yyyy")</dd>

                    <dt class="col-sm-4">Género</dt>
                    <dd class="col-sm-8">@Model.Genero</dd>

                    <dt class="col-sm-4">Nacionalidad</dt>
                    <dd class="col-sm-8">@Model.Nacionalidad</dd>

                    <dt class="col-sm-4">Lugar de Nacimiento</dt>
                    <dd class="col-sm-8">@Model.LugarNacimiento</dd>

                    <dt class="col-sm-4">N° Expediente</dt>
                    <dd class="col-sm-8">@Model.NumeroExpediente</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-info-circle"></i> Contacto y situación
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Estado actual</dt>
                    <dd class="col-sm-8">@Model.EstadoActual</dd>

                    <dt class="col-sm-4">Escolaridad</dt>
                    <dd class="col-sm-8">@Model.Escolaridad</dd>

                    <dt class="col-sm-4">Teléfono</dt>
                    <dd class="col-sm-8">@Model.Telefono</dd>

                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@Model.Email</dd>

                    <dt class="col-sm-4">Obra social</dt>
                    <dd class="col-sm-8">@Model.ObraSocial</dd>

                    <dt class="col-sm-4">Domicilio</dt>
                    <dd class="col-sm-8">@Model.Domicilio</dd>
                </dl>
            </div>
        </div>

        <div class="card mt-4">
            <div class="card-header">
                <i class="bi bi-calendar-check"></i> Turnos Recientes
            </div>
            <div class="card-body">
                @if (Model.Turnos.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var turno in Model.Turnos.Take(5))
                                {
                                    <tr>
                                        <td>@turno.Fecha.ToString("dd/MM/yyyy")</td>
                                        <td>@turno.EstadoTurno?.Nombre</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted">No hay turnos registrados.</p>
                }
            </div>
        </div>
    </div>
</div>
